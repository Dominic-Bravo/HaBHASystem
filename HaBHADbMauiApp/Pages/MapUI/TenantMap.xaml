<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             xmlns:loc="clr-namespace:Microsoft.Maui.Devices.Sensors;assembly=Microsoft.Maui.Essentials"
             x:Class="MapforMaui.MapUI.TenantMap"
             Title="TenantMap">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackLayout Grid.Row="0" VerticalOptions="Start" HorizontalOptions="Center">
            <Button Text="Click Me To Add Your BoardingHouse Location"
                    Clicked="AddPinButton_Clicked"
                    VerticalOptions="Start"
                    Margin="0,40"
                    HorizontalOptions="Center" />
        </StackLayout>

        <maps:Map x:Name="mappy"
                  IsShowingUser="True"
                  MapType="Hybrid"
                  Margin="0"
                  MapClicked="OnMapClicked"
                  VerticalOptions="FillAndExpand"
                  HorizontalOptions="FillAndExpand"
                  Grid.Row="1" />

        <HorizontalStackLayout Grid.Row="2" Margin="0" Spacing="1" VerticalOptions="End" HorizontalOptions="Center" Padding="0">
            <ImageButton WidthRequest="65"
                         HeightRequest="65"
                         Source="manage.png"
                         BackgroundColor="#E5E5E5"
                         CornerRadius="5"
                         Clicked="ImageButton_Clicked" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
