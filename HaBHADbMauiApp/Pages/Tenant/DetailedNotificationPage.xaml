<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HaBHADbMauiApp.Pages.Tenant.DetailedNotificationPage"
             Title="DetailedNotificationPage" BackgroundColor="White">
    <VerticalStackLayout>
        
        
    <Frame Margin="0,20" CornerRadius="50" WidthRequest="350" HeightRequest="50" BackgroundColor="Black" >
        <Label Text="Room Details" HeightRequest="35" TextColor="White" HorizontalOptions="Center" Margin="5" FontAttributes="None" FontSize="20"/>
    </Frame>
        <StackLayout Grid.Row="1" HorizontalOptions="Center">

            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <Label Text="Room Number: " TextColor="Black" Grid.Column="0" FontAttributes="Bold" FontSize="16" />
                <Label Text="{Binding RoomNumber}" TextColor="Black" Grid.Column="1" FontSize="16" />
            </Grid>
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <Label Text="Pax Size: " TextColor="Black" Grid.Column="0" FontAttributes="Bold" FontSize="16"/>
                <Label Text="{Binding RoomSize}" TextColor="Black" Grid.Column="1" FontSize="16"/>
            </Grid>
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Label Text="Description: " TextColor="Black" Grid.Column="0" FontAttributes="Bold" FontSize="16"/>
                <Label Text="{Binding Descriptions}" TextColor="Black" Grid.Column="1" FontSize="16"/>
            </Grid>
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Label Text="Room Price: " TextColor="Black" Grid.Column="0" FontAttributes="Bold" FontSize="16"/>
                <Label Text="{Binding PricePerMonth, StringFormat='₱{0:N2}'}" TextColor="Black"  Grid.Column="1" FontSize="16"/>
            </Grid>
        </StackLayout>
        <VerticalStackLayout>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

                <Frame Margin="0,20" CornerRadius="50" WidthRequest="350" HeightRequest="50" BackgroundColor="Black" >
                    <Label Text="Boarder Details" HeightRequest="35" TextColor="White" HorizontalOptions="Center" Margin="5" FontAttributes="None" FontSize="20"/>
                </Frame>



                <StackLayout Grid.Row="3" HorizontalOptions="Center" Margin="20">

                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                        <Label Text="First Name: " TextColor="Black" Grid.Column="0" FontAttributes="Bold" FontSize="16" />
                        <Label Text="{Binding FirstName}" TextColor="Black" x:Name="TxtFirstName" Grid.Column="1" FontSize="16" />
                </Grid>
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                        <Label Text="Last Name: "  TextColor="Black" Grid.Column="0" FontAttributes="Bold" FontSize="16"/>
                        <Label Text="{Binding LastName}" TextColor="Black" x:Name="TxtLastName" Grid.Column="1" FontSize="16"/>
                </Grid>
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                        <Label Text="Contact Number: " TextColor="Black" Grid.Column="0" FontAttributes="Bold" FontSize="16"/>
                        <Label Text="{Binding ContactNumber}" TextColor="Black" x:Name="TxtContactNumber" Grid.Column="1" FontSize="16"/>
                </Grid>
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                        <Label Text="Email: " Grid.Column="0" TextColor="Black" FontAttributes="Bold" FontSize="16"/>
                        <Label Text="{Binding EmailAddress}" TextColor="Black" x:Name="TxtEmail" Grid.Column="1" FontSize="16"/>
                </Grid><Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                        <Label Text="Adress: " Grid.Column="0" TextColor="Black" FontAttributes="Bold" FontSize="16"/>
                        <Label Text="{Binding Location}" TextColor="Black" x:Name="TxtLocation" Grid.Column="1" FontSize="16"/>
                </Grid>
            </StackLayout>

            <Grid ColumnSpacing="10" Grid.Row="4" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Text="Reject" x:Name="BtnReject" TextColor="White" Clicked="BtnReject_Clicked" Grid.Column="0" BackgroundColor="Blue"/>
                    <Button Text="Approve" x:Name="BtnApprove" TextColor="White" Clicked="BtnApprove_Clicked" Grid.Column="1" BackgroundColor="Blue"/>
            </Grid>

        </Grid>
    </VerticalStackLayout>
    </VerticalStackLayout>

</ContentPage>