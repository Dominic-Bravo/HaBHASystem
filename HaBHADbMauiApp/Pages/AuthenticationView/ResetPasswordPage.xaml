<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HaBHADbMauiApp.Pages.AuthenticationView.ResetPasswordPage"
             Title="Reset Password">

    <VerticalStackLayout BackgroundColor="White" Padding="30" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

        <!-- Frame to apply corner radius -->
        <Frame Margin="0,250" BackgroundColor="LightGray" CornerRadius="20" Padding="20" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand">
            <!-- Form -->
            <VerticalStackLayout Spacing="12" HorizontalOptions="FillAndExpand">

                <!-- Title -->
                <Label 
                    Text="Reset Password" 
                    FontSize="24" 
                    FontAttributes="Bold" 
                    TextColor="Black"
                    HorizontalOptions="Center" 
                    Margin="0,0,0,20"/>

                <!-- New Password Input -->
                <Entry x:Name="TxtNewPassword" 
                      
                       Placeholder="New Password" 
                       TextColor="Black" 
                       BackgroundColor="White" 
                       IsPassword="True"
                       HeightRequest="40" />

                <!-- Confirm Password Input -->
                <Entry x:Name="TxtConfirmPassword" 
                       Placeholder="Confirm Password" 
                       TextColor="Black" 
                       BackgroundColor="White" 
                       IsPassword="True"
                       HeightRequest="40" />

                <!-- Submit Button -->
                <Button 
                    Text="Submit" 
                    x:Name="BtnSubmit" 
                    Clicked="BtnSubmit_Clicked" 
                    BackgroundColor="Blue" 
                    TextColor="White" 
                    Padding="10" 
                    HorizontalOptions="FillAndExpand"
                    CornerRadius="8" 
                    Margin="0,15"/>

            </VerticalStackLayout>
        </Frame>

    </VerticalStackLayout>

</ContentPage>


