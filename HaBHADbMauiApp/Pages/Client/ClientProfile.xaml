<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HaBHADbMauiApp.Pages.Client.ClientProfile"
             Title="ClientProfile" BackgroundColor="White">
    <VerticalStackLayout>
        
        
    <VerticalStackLayout Padding="10">
        <Frame CornerRadius="50" WidthRequest="350" HeightRequest="50" BackgroundColor="Black" >
            <Label Text="Your Details" HeightRequest="35" TextColor="White" HorizontalOptions="Center" Margin="5" FontAttributes="None" FontSize="20"/>
        </Frame>
        
    </VerticalStackLayout>
        
    <VerticalStackLayout>

            <Frame BackgroundColor="LightGray">
           
                 <Label Text="{Binding FirstName}" TextColor="Black" FontSize="16" />
             
            </Frame>

        </VerticalStackLayout>

        <VerticalStackLayout Padding="10">
            <Frame CornerRadius="50" WidthRequest="350" HeightRequest="50" BackgroundColor="Black" >
                <Label Text="Your Boarding House Details" HeightRequest="35" TextColor="White" HorizontalOptions="Center" Margin="5" FontAttributes="None" FontSize="20"/>
            </Frame>

        </VerticalStackLayout>

        <VerticalStackLayout>

            <Frame BackgroundColor="LightGray">
                <Label Text="Dere Ibutang Ang Details sa Bh">

                </Label>
            </Frame>

        </VerticalStackLayout>
        <Label x:Name="TxtName" Text="{Binding FirstName}" TextColor="Black" FontSize="16" />
        <Label Text="{Binding RoomNumber}" TextColor="Black" FontSize="16" />
        <Label Text="{Binding FirstName}" TextColor="Black" FontSize="16" />
        <Label Text="{Binding LastName}" TextColor="Black" FontSize="16" />
        <Label Text="{Binding MiddleInitial}" TextColor="Black" FontSize="16" />
        <Label Text="{Binding ContactNumber}" TextColor="Black" FontSize="16" />
        <Label Text="{Binding Location}" TextColor="Black" FontSize="16" />
        <Label Text="{Binding Email}" TextColor="Black" FontSize="16" />


    </VerticalStackLayout>
</ContentPage>